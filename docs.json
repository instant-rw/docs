{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Instant Cloud",
  "colors": {
    "primary": "#007A55",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/android-chrome-512x512.png",
    "dark": "/images/android-chrome-512x512.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/LogoDark.png",
    "dark": "/images/Component2.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@instant.rw"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://instant.rw/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/instantrw",
      "github": "https://github.com/instant-rw",
      "linkedin": "https://linkedin.com/company/instant-rw",
      "instagram": "https://instagram.com/instant.rw"
    }
  },
  "thumbnails": {
    "background": "/images/og-image.png"
  },
  "fonts": {
    "family": "Inter"
  }
}
